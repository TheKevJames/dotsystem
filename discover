#!/usr/bin/env python3
import pathlib
from collections.abc import Iterator

HOME = pathlib.Path.home()
ROOT = pathlib.Path(__file__).parent / 'root' / '~'
FOLDERS = [
    '.config/nvim',
    '.config/tmuxifier/layouts',
    '.config/zsh/dropins',
    '.local/bin',
]
# TODO: synchronize this list with packagers installed by ./sync
IGNORE = {'aerospace', 'circleci', 'git-standup', 'gog', 'lazy-lock.json'}


def find(folder: str) -> Iterator[pathlib.Path]:
    for file in (HOME / folder).rglob('*'):
        if not file.is_file() or file.is_symlink() or file.name in IGNORE:
            continue

        if not (ROOT / file.relative_to(HOME)).exists():
            if not file.name.startswith('nobackup-'):
                yield file


def main() -> None:
    # TODO: discover installed packages not in dotsystem config
    print('Discovering files in need of backup...')

    for folder in FOLDERS:
        files = list(find(folder))
        if files:
            print()
            print(f'The following files in {folder} may be in need of backup:')
            for file in files:
                print(file)


if __name__ == '__main__':
    main()
