#!/usr/bin/env bash
set -euo pipefail

echo "Upgrading system packages..."
if [[ "${OSTYPE}" == "darwin"* ]]; then
    sudo port selfupdate
    sudo port upgrade outdated
    sudo port reclaim
else
    sudo dnf upgrade --refresh
    sudo dnf autoremove
fi

echo "Upgrading rust..."
rustup update

echo "Upgrading cargo packages..."
cargo-upgrade

echo "Upgrading uv tools..."
uv tool upgrade --all

echo "Upgrading bun packages..."
bun update -g

echo "Upgrading npm packages..."
npm outdated -g --depth=0 --json | jq -r '. | keys[]' | xargs npm update -g

echo "Upgrading pi and extensions..."
pi update --all

echo "Upgrading gcloud components..."
gcloud components update

echo "Upgrading installed-from-source packages..."
for repo in $(git config -f ~/.config/dotsystem/packages --name-only --get-regexp 'git\..*' | cut -f2 -d.); do
    pushd "${XDG_SRC_HOME}/${repo}"
    git pull
    [[ "${repo}" == "git-standup" ]] && make install PREFIX="${XDG_BIN_HOME%/bin}"
    popd
done

echo "Upgrading neovim plugins..."
nvim --headless '+Lazy! sync' +qa
nvim --headless '+MasonUpdate' +qa
nvim --headless '+MasonToolsUpdateSync' +qa
nvim --headless '+TSUpdateSync' +qa

echo "done."
