#!/usr/bin/env bash
set -euo pipefail

echo "Upgrading system packages..."
if which zypper >/dev/null; then
    sudo zypper refresh
    sudo zypper update
    sudo zypper packages --unneeded
    # sudo zypper packages --unneeded | grep ^i | cut -d '|' -f 3 | xargs sudo zypper remove --clean-deps
elif which port >/dev/null; then
    sudo port selfupdate
    sudo port upgrade outdated
    sudo port reclaim
elif which apt-get >/dev/null; then
    sudo apt-get update
    sudo apt-get upgrade
    sudo apt-get autoremove
elif which dnf >/dev/null; then
    sudo dnf upgrade
    sudo dnf autoremove
else
    echo "ERROR: could not determine package manager."
    exit 1
fi

echo "Upgrading rust..."
rustup update

echo "Upgrading cargo packages..."
cargo-upgrade

echo "Upgrading pipx packages..."
pipx upgrade-all

echo "Upgrading bun packages..."
bun update -g

echo "Upgrading npm packages..."
npm outdated -g --depth=0 --json | jq -r '. | keys[]' | xargs npm update -g

echo "Upgrading pi and extensions..."
pi update --all

echo "Upgrading gcloud components..."
gcloud components update

echo "Upgrading installed-from-source packages..."
for repo in $(git config -f ~/.config/dotsystem/packages --name-only --get-regexp 'git\..*' | cut -f2 -d.); do
    pushd "${XDG_SRC_HOME}/${repo}"
    git pull
    [[ "${repo}" == "git-standup" ]] && make install PREFIX="${XDG_BIN_HOME%/bin}"
    popd
done

echo "Upgrading kubectl plugins..."
kubectl krew update
kubectl krew upgrade

echo "Upgrading neovim plugins..."
nvim --headless '+Lazy! sync' +qa
nvim --headless '+MasonUpdate' +qa
nvim --headless '+MasonToolsUpdateSync' +qa
nvim --headless '+TSUpdateSync' +qa

echo "done."
