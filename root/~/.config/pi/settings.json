{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-4-8",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "enableSkillCommands": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 19200,
    "keepRecentTokens": 19200
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "shellCommandPrefix": "export MANPAGER=cat",
  "quietStartup": true,
  "lastChangelogVersion": "0.84.4",
  "enabledModels": [
    "anthropic/claude-opus-4-8",
    "google/gemini-3.7-flash"
  ],
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-subagents"
  ],
  "skills": [
     "~/.config/matt-pocock/skills"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "inheritSkills": true
      },
      "advisor": {
        "disabled": true
      },
      "context-builder": {
        "disabled": true
      },
      "oracle": {
        "disabled": true
      },
      "planner": {
        "disabled": true
      },
      "researcher": {
        "inheritSkills": true
      },
      "reviewer": {
        "disabled": true
      },
      "scout": {
        "disabled": true
      },
      "worker": {
        "disabled": true
      }
    }
  }
}
