; packages from the OS package manager
; if the binary doesn't match the package name, use:
;   $pkg = $binary
[pkg]
  ; build
  autoconf
  bison
  cmake
  m4
  make

  ; utils
  curl
  entr
  gnupg2 = gpg
  jq
  less
  pinentry
  tar
  unzip
  wget

  ; git
  gh
  git
  git-absorb

  ; lang
  clang
  go

  ; apps
  btop
  firefox
  gmailctl
  neovim = nvim
  podman
  syncthing
  tmux
  zsh

; packages from the OS package manager, OSX only
[Darwin]
  jira-cli = jira
  python311 = python3.11
  python312 = python3.12
  python313 = python3.13
  python314 = python3.14
  python315 = python3.15
  ; TODO: aerospace  ; https://nikitabobko.github.io/AeroSpace/guide#manual-installation
  ; TODO: uv

; packages from the OS package manager, Linux only
[Linux]
  python3 = python3
  uv
  ; TODO: jira-cli = jira

; rust tools, installed via cargo
; if any values are set, also install rustup/cargo
[cargo]
  ast-grep = sg
  bat
  difftastic = difft
  eb
  eza
  fd-find = fd
  git-delta = delta
  git-cliff
  hexyl
  hyperfine
  mergiraf
  pastel
  ripgrep = rg
  sd
  vivid

; tools installed via git clone
; format:
;   $repo = $user
[git]
  argbash = matejak
  git-standup = kamranahmedse
  gogcli = steipete
  prettyping = denilsonsa
  tmux-xpanes = greymd
  tmuxifier = jimeh
  xdg-ninja = b3nj5m1n

; ; js tools, installed via bun
[bun]
  confluence-cli
  eval = "@google/clasp clasp"
  eval = "@likec4/language-server likec4-language-server"
  eval = "@earendil-works/pi-coding-agent pi"
  local = ~/src/personal/bakery/pi
  neovim = neovim-node-host
  renovate

; pi extensions, installed via pi
[pi]

; python tools, installed via uv tool
[uv]
  beancount = bean-check
  beanquery = bean-query
  fava
  local = ~/src/personal/bakery/bakery
  local = ~/src/personal/beancount-importer
  local = ~/src/personal/dotsystem/scripts
  local = ~/src/personal/task
  neovim-remote = nvr
  prek
  ruff
  shellcheck-py = shellcheck
  tox
  ty
  yq

; anything with a manual install process defined in ./sync
[manual]
  bun
  gcloud
  meslo
