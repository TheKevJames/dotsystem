#!/usr/bin/env python3
import json
import os
import pathlib
import sys
import traceback


STATE = os.getenv('XDG_STATE_HOME') or pathlib.Path.home() / '.local' / 'state'
DATA = (pathlib.Path(STATE) / 'session-pi').resolve()


def sessions_dir() -> pathlib.Path:
    return (pathlib.Path(STATE) / 'pi' / 'sessions').resolve()


# Sessions live flat in the store as `<TIMESTAMP>_<uuid>.jsonl`; subagent
# sidecar files sit under `<TIMESTAMP>_<uuid>/` subdirs, so a non-recursive
# glob keeps us to the real top-level sessions and skips those underscore-less
# inner files.
def top_level_sessions() -> list[pathlib.Path]:
    return [s for s in sessions_dir().glob('*.jsonl') if '_' in s.name]


def find_path(provided: str) -> str:
    for session in top_level_sessions():
        session_id = session.name.split('_')[1].split('.')[0]
        if session_id == provided:
            path: str = json.loads(session.read_text().splitlines()[0])['cwd']
            return path

    print(f'session {provided} not found')
    sys.exit(1)


def get_session() -> tuple[str, str]:
    path = str(pathlib.Path.cwd().resolve())

    candidates = []
    for session in top_level_sessions():
        try:
            header = json.loads(session.read_text().splitlines()[0])
        except (OSError, ValueError, IndexError):
            continue
        if header.get('cwd') == path:
            candidates.append(session)

    if not candidates:
        print(f'no session found for {path}')
        sys.exit(1)

    latest = max(candidates, key=lambda f: f.stat().st_ctime)
    session_id = latest.name.split('_')[1].split('.')[0]
    return (path, session_id)


def print_state(state: list[str]) -> None:
    for line in state:
        path, name, _ = line.split('\t')
        print(f'{path}: {name}')


def do_delete(name: str) -> int:
    state = DATA.read_text().splitlines()

    found = False
    trimmed: list[str] = []
    for item in state:
        path, item_name, _ = item.split('\t')
        if item_name == name:
            print(f'DELETE {path}: {item_name}')
            found = True
        else:
            trimmed.append(item)

    DATA.write_text('\n'.join(trimmed))
    print_state(trimmed)
    return 0 if found else 1


def do_list() -> int:
    print_state(DATA.read_text().splitlines())
    return 0


def do_load(name: str) -> int:
    state = DATA.read_text().splitlines()
    for item in state:
        path, item_name, session_id = item.split('\t')
        if name == item_name:
            os.chdir(pathlib.Path(path).expanduser())
            os.execvp(
                'pi',
                ('pi', '--session-id', session_id),
            )
            # implicit return here, execvp forks

    print(f'invalid session {name}')
    print_state(state)
    return 1


def do_save(name: str, session_id: str | None) -> int:
    if session_id is not None:
        path = find_path(session_id)
    else:
        path, session_id = get_session()

    path = path.replace(str(pathlib.Path.home()), '~')
    data = (path, name, session_id)

    state = DATA.read_text().splitlines()
    for item in state:
        _, item_name, _ = item.split('\t')
        if name == item_name:
            print(f'duplicate session {name}')
            return 1

    state += ['\t'.join(data)]
    DATA.write_text('\n'.join(state))
    print_state(state)
    return 0


def main() -> int:
    DATA.touch()
    try:
        if len(sys.argv) == 1 or sys.argv[1] == 'list':
            return do_list()

        if sys.argv[1] in {'--help', 'help'}:
            pass

        if len(sys.argv) >= 3:
            name = sys.argv[2]
            if sys.argv[1] == 'delete':
                return do_delete(name)
            if sys.argv[1] == 'load':
                return do_load(name)
            if sys.argv[1] == 'save':
                session_id = sys.argv[3] if len(sys.argv) > 3 else None
                return do_save(name, session_id)
    except Exception:
        traceback.print_exc()

    print('usage:')
    print(f'  {sys.argv[0]} list')
    print(f'  {sys.argv[0]} delete NAME')
    print(f'  {sys.argv[0]} load NAME')
    print(f'  {sys.argv[0]} save NAME [SESSIONID]')
    return 1


if __name__ == '__main__':
    sys.exit(main())
