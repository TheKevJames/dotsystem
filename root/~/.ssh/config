Include ~/.config/colima/ssh_config

AddKeysToAgent yes

Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host github.com-dialpad
    HostName github.com
    User git
    IdentityFile ~/.ssh/dialpad
    IdentitiesOnly yes

Host bmaxbox
    HostName bmaxbox.local
    User kevin
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
