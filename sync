#!/usr/bin/env bash
set -euo pipefail

# Variables
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOOTSTRAP="n"
FORCE="n"
SKIP="n"

while getopts bfhs-: OPT; do
    # support long options: https://stackoverflow.com/a/28466267/519360
    if [ "$OPT" = "-" ]; then
        OPT="${OPTARG%%=*}"
        OPTARG="${OPTARG#"${OPT}"}"
        OPTARG="${OPTARG#=}"
    fi

    case "${OPT}" in
        b | bootstrap )
            BOOTSTRAP="y" ;;
        f | force )
            FORCE="y" ;;
        h | help )
            echo "syncs your system from your dotsystem config";
            echo;
            echo "Options:";
            echo "  --bootstrap         force bootstrap mode (normally auto-detected)";
            echo "  --force             force over-write of all missing/modified files";
            echo "  --skip-packages     do not update installed packages";
            exit 0 ;;
        s | skip-packages )
            SKIP="y" ;;
        ??* )
            echo "Illegal option --${OPT}";
            exit 1 ;;
        ? )
            exit 1 ;;
    esac
done

if [[ ! -f ~/.ssh/id_ed25519 ]]; then
    echo "No ssh key found, forcing bootstrap mode..."
    echo
    BOOTSTRAP="y"
fi

echo "Running dotsystem with settings..."
echo "  Bootstrap: ${BOOTSTRAP}"
echo "  Force: ${FORCE}"
echo "  Skip Packages: ${SKIP}"

# TODO: add source directives for other `export` commands
source "${DIR}/root/~/.zshenv"
source "${DIR}/root/~/.config/zsh/dropins/xdg.zsh"

if [[ "${OSTYPE}" == "darwin"* ]]; then
    if ! which port >/dev/null; then
        echo "ERROR: please install MacPorts from https://macports.org/install.php"
        echo "After installation, if this is a fresh machine, run:"
        echo "  xcodebuild -runFirstLaunch"
        exit 1
    fi

    PACMAN_REFRESH="sudo port sync"
    PACMAN_INSTALL="sudo port install"
else
    PACMAN_REFRESH=":"
    PACMAN_INSTALL="sudo dnf install"
fi

if [[ "${BOOTSTRAP}" == "y" ]]; then
    echo "Detected fresh system, beginning bootstrap mode..."
    if [[ "${SKIP}" == "y" ]]; then
        if ! which m4 >/dev/null; then
            echo "m4 is not installed but --skip-packages is set, exiting."
            exit 1
        fi
        echo "--skip-packages specified, some bootstrapping will be skipped"
    fi

    # ensure m4 is installed, nothing will work without it
    if ! which m4 >/dev/null; then
        echo "Refreshing sources and installing m4..."
        eval "${PACMAN_REFRESH}" >/dev/null
        eval "${PACMAN_INSTALL} m4"
    fi

    # set hostname
    read -rp "Enter system hostname: " NEW_HOSTNAME
    sudo hostname "${NEW_HOSTNAME}"
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sudo scutil --set HostName "${NEW_HOSTNAME}"
        sudo scutil --set LocalHostName "${NEW_HOSTNAME}"
        sudo scutil --set ComputerName "${NEW_HOSTNAME}"
    fi
    echo "Set new system hostname. Remember to reboot!"

    if [[ "$OSTYPE" == "darwin"* ]]; then
        # shadow OSX's managed git version with a reasonably up-to-date one
        echo "Fetching a newer version of git..."
        eval "${PACMAN_REFRESH}" >/dev/null
        eval "${PACMAN_INSTALL} git"

        echo "Enabling nosudo for osascript..."
        echo "$(whoami) ${NEW_HOSTNAME} = (root) NOPASSWD: /usr/bin/osascript" | sudo tee /etc/sudoers.d/osascript
    fi

    echo "Creating ~/.ssh/id_ed25519..."
    ssh-keygen -o -a 100 -t ed25519 -C "KevinJames@thekev.in" -f ~/.ssh/id_ed25519
fi

# Helpers
ensure_dir() {
    if [ ! -d "$1" ]; then
        echo "Creating $1"
        mkdir -p "$1" 2>/dev/null || sudo mkdir -p "$1"
    fi
}

ensure_file() {
    ensure_dir "$(dirname "$1")"
    if [ ! -f "$1" ]; then
        touch "$1" 2>/dev/null || sudo touch "$1"
    fi
}

set_file() {
    DEST=${2/\~/$HOME}
    ensure_file "${DEST}" || {
        echo "> bad permissions, skipping";
        return 0;
    }

    if ! sudo diff -q "${1}" "${DEST}" >/dev/null; then
        echo "${DEST} will be modified according to the following diff."
        sudo diff "${DEST}" "${1}" || true

        if [[ "${FORCE}" == "y" ]]; then
            cp "${1}" "${DEST}" 2>/dev/null || sudo cp "${1}" "${DEST}"
            if [[ "${DEST}" == *"/bin/"* ]]; then sudo chmod a+x "${DEST}"; fi
        else
            options=("Yes" "No")
            if [[ "${1}" == "${DIR}"/* ]]; then
                # N.B. "update git repo from local changes" copies the live
                # file back over $1, so it only makes sense when $1 is the repo
                # source. Templated files (eg. m4 output) are rendered into a
                # throwaway temp outside ${DIR}, so we detect repo sources by
                # their path and omit the option otherwise.
                options+=("Update git repo from local changes")
            fi
            echo "Apply this change?"
            select yn in "${options[@]}"; do
                case $yn in
                    Yes )
                        cp "${1}" "${DEST}" 2>/dev/null || sudo cp "${1}" "${DEST}";
                        if [[ "${DEST}" == *"/bin/"* ]]; then sudo chmod a+x "${DEST}"; fi;
                        break ;;
                    No )
                        break ;;
                    "Update git repo from local changes" )
                        cp "${DEST}" "${1}";
                        break ;;
                esac
            done
        fi
    fi
}

pathadd() {
    if [ -d "$1" ] && [[ ":$PATH:" != *":$1:"* ]]; then
        PATH="${PATH:+"$PATH:"}$1"
    fi
}

## Update global configs
echo "Configuring system..."

# configure retrievable config
TEMPFILE=$(mktemp)
echo "divert(-1)" > "${TEMPFILE}"
echo "define(\`M4_HOSTNAME', \`${HOSTNAME}')" >> "${TEMPFILE}"
echo "divert(0)dnl" >> "${TEMPFILE}"
set_file "${TEMPFILE}" "${XDG_DATA_HOME}/dotsystem/config.m4"

# N.B. feed `find` on fd 3 so the loop body's stdin (fd 0) stays the terminal.
# Otherwise `select` inside `set_file` would read from the file list instead of
# the user, and the interactive prompt would break.
while IFS= read -rd '' file <&3; do
    if [[ "${file##*.}" == "m4" ]]; then
        TEMPFILE=$(mktemp)
        m4 \
            "${XDG_DATA_HOME}/dotsystem/config.m4" \
            "${file}" 2>/dev/null > "${TEMPFILE}"
        file_noext="${file%.*}"
        set_file "${TEMPFILE}" "/${file_noext#"${DIR}"/root/}"
    elif [[ "${file##*.}" == "once" ]]; then
        file_noext="${file%.*}"
        DEST="/${file_noext#"${DIR}"/root/}"
        DEST=${DEST/\~/$HOME}
        if [[ ! -f "$DEST" ]]; then
            set_file "${file}" "${DEST}"
        fi
    else
        set_file "${file}" "/${file#"${DIR}"/root/}"
    fi
done 3< <(find "${DIR}/root" -type f -print0)

## Configure OSX one-offs
if [[ "$OSTYPE" == "darwin"* ]]; then
    sudo cp "${XDG_CONFIG_HOME}"/osx/in.thekev.caffeinate.plist /Library/LaunchAgents/in.thekev.caffeinate.plist
    bash "${XDG_CONFIG_HOME}/osx/config"
fi

echo "done."

if [[ "${SKIP}" == "y" ]]; then
    exit 0
fi

## Install packages
echo "Refreshing sources..."
eval "${PACMAN_REFRESH}" >/dev/null

PACKAGE_CONFIG="${XDG_CONFIG_HOME}/dotsystem/packages"
echo "Installing packages..."
packages=()
while IFS=$'\r' read -r package; do
    IFS=' ' read -ra fields <<< "$package"
    pkg="${fields[0]#pkg.}"
    binary="${fields[1]:-${pkg}}"
    if ! which "${binary}" >/dev/null 2>&1; then
        packages+=("${pkg}")
    fi
done < \
    <(cat \
        <(git config -f "${PACKAGE_CONFIG}" --get-regexp 'pkg\..*') \
        <(git config -f "${PACKAGE_CONFIG}" --get-regexp "$(uname -s)\..*" | sed "s/$(uname -s)/pkg/i") \
    )

# shellcheck disable=SC2294
if (( ${#packages[@]} )); then
    eval "${PACMAN_INSTALL}" "${packages[@]}"
fi

## Configure OSX one-offs
if [[ "$OSTYPE" == "darwin"* ]]; then
    # force override of OSX's way out-of-date builtin
    if [[ ! -f "/opt/local/bin/zsh" ]]; then
        sudo port install zsh
        echo "/opt/local/bin/zsh" | sudo tee -a /etc/shells
    fi
fi

## Install packages with special manual requirements
if git config -f "${PACKAGE_CONFIG}" --get manual.bun >/dev/null; then
    if ! which bun >/dev/null; then
        if [[ "$OSTYPE" == "darwin"* ]]; then
            # TODO: switch to self-managed install
            eval "${PACMAN_INSTALL}" bun
        else
            TEMPDIR=$(mktemp -d)
            TEMPFILE=$(mktemp)

            TARGET="bun-linux-x64"
            curl -fsSL "https://github.com/oven-sh/bun/releases/latest/download/${TARGET}.zip" >"${TEMPFILE}.zip"
            unzip -oqd "${TEMPDIR}" "${TEMPFILE}.zip"
            mv "${TEMPDIR}/${TARGET}/bun" "${XDG_BIN_HOME}/bun"
            chmod a+x "${XDG_BIN_HOME}/bun"
        fi
    fi
fi

if git config -f "${PACKAGE_CONFIG}" --get manual.gcloud >/dev/null; then
    if ! which gcloud >/dev/null; then
        TEMPFILE=$(mktemp)
        if [[ "$OSTYPE" == "darwin"* ]]; then
            curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-darwin-arm.tar.gz" >"${TEMPFILE}.tar.gz"
        else
            curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-$(uname -m).tar.gz" >"${TEMPFILE}.tar.gz"
        fi
        tar -xf "${TEMPFILE}.tar.gz" -C "${XDG_SRC_HOME}"
    fi
fi

# TODO: consider switching to a subset implementation, only I *really* need
# this for the emergency key...
# Switching off would also let me purge golang...
# TODO: switch to ssh keysigning
if [ ! -f "${GOPATH}/bin/passphrase2pgp" ]; then
    pathadd /usr/local/go/bin
    go install nullprogram.com/x/passphrase2pgp@v1.2.0
fi

if git config -f "${PACKAGE_CONFIG}" --get manual.meslo >/dev/null; then
    if [[ "$OSTYPE" == "darwin"* ]]; then
        path="/Library/Fonts/NerdFonts"
    else
        path="/usr/local/share/fonts/NerdFonts"
    fi

    if [[ ! -f "${path}/MesloLGLNerdFont-Regular.ttf" ]]; then
        TEMPFILE=$(mktemp)
        # TODO: versioning
        curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/Meslo.tar.xz" > "${TEMPFILE}.tar.xz"
        sudo mkdir -p "${path}"
        sudo tar -xf "${TEMPFILE}.tar.xz" -C "${path}"

        if [[ "$OSTYPE" != "darwin"* ]]; then
            fc-cache -f "${path}"
        fi
    fi
fi


## Install bun packages
if git config -f "${PACKAGE_CONFIG}" --get-regexp 'bun\..*' >/dev/null; then
    export BUN_INSTALL_GLOBAL_DIR="${XDG_DATA_HOME}/bun"
    export BUN_INSTALL_BIN="${XDG_BIN_HOME}"
    pathadd "${XDG_BIN_HOME}"

    while IFS=$'\r' read -r package; do
        IFS=' ' read -ra fields <<< "$package"
        pkg="${fields[0]#bun.}"
        binary="${fields[1]:-${pkg}}"
        # N.B. many packages use characters disallowed from git config field
        # names, so we use a special "eval" value to give us a hint to parse
        # differently
        if [[ "${pkg}" == "eval" ]]; then
            pkg="${fields[1]}"
            binary="${fields[2]:-${pkg}}"
        fi
        # N.B. entries named `local` carry a project path as their value; its
        # lockfile is reinstalled every sync so dependency bumps propagate.
        if [[ "${pkg}" == "local" ]]; then
            path="${binary/#\~/$HOME}"
            if [[ ! -d "${path}" ]]; then
                echo "ERROR: no ${path} on local device"
                continue
            fi
            bun install --frozen-lockfile --cwd "${path}"
            continue
        fi

        if ! which "${binary}" >/dev/null 2>&1; then
            bun add -g "${pkg}"
        fi
    done < <(git config -f "${PACKAGE_CONFIG}" --get-regexp 'bun\..*')
fi

## Install cargo packages
if git config -f "${PACKAGE_CONFIG}" --get-regexp 'cargo\..*' >/dev/null; then
    export CARGO_HOME="${XDG_DATA_HOME}/cargo"
    if ! which cargo >/dev/null; then
        TEMPFILE=$(mktemp)
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs > "${TEMPFILE}.sh"
        sh "${TEMPFILE}.sh" -y --no-modify-path
        "${CARGO_HOME}/bin/rustup" default stable
    fi
    pathadd "${CARGO_HOME}/bin"

    packages=()
    while IFS=$'\r' read -r package; do
        IFS=' ' read -ra fields <<< "$package"
        pkg="${fields[0]#cargo.}"
        binary="${fields[1]:-${pkg}}"
        if ! which "${binary}" >/dev/null 2>&1; then
            packages+=("${pkg}")
        fi
    done < <(git config -f "${PACKAGE_CONFIG}" --get-regexp 'cargo\..*')
    if (( ${#packages[@]} )); then
        cargo install "${packages[@]}"
    fi
fi

## Install git-based packages
while IFS=$'\r' read -r package; do
    IFS=' ' read -ra fields <<< "$package"
    repo="${fields[0]#git.}"
    user="${fields[1]}"
    if [[ ! -d "${XDG_SRC_HOME}/${repo}" ]]; then
        git clone "https://github.com/${user}/${repo}.git" "${XDG_SRC_HOME}/${repo}"

        # TODO: support this via config
        if [[ "${repo}" == "git-standup" ]]; then
            make -C "${XDG_SRC_HOME}/${repo}" install PREFIX="${XDG_BIN_HOME%/bin}"
        elif [[ "${repo}" == "gogcli" ]]; then
            make -C "${XDG_SRC_HOME}/${repo}" BIN_DIR="${XDG_BIN_HOME%/bin}"
        elif [[ "${repo}" == "prettyping" ]]; then
            chmod a+x "${XDG_SRC_HOME}/${repo}/prettyping"
            ln -s "${XDG_SRC_HOME}/${repo}/prettyping" "${XDG_BIN_HOME}/prettyping"
        elif [[ "${repo}" == "xdg-ninja" ]]; then
            chmod a+x "${XDG_SRC_HOME}/${repo}/xdg-ninja.sh"
            ln -s "${XDG_SRC_HOME}/${repo}/xdg-ninja.sh" "${XDG_BIN_HOME}/xdg-ninja"
        fi
    fi
done < <(git config -f "${PACKAGE_CONFIG}" --get-regexp 'git\..*')

## Install pi extensions
if git config -f "${PACKAGE_CONFIG}" --get-regexp 'pi\..*' >/dev/null; then
    while IFS=$'\r' read -r package; do
        IFS=' ' read -ra fields <<< "$package"
        pkg="${fields[0]#pi.}"
        binary="${fields[1]:-${pkg}}"
        if [[ ! -e "${PI_CODING_AGENT_DIR:-${HOME}/src/personal/bakery/interactive}/npm/node_modules/${pkg}" ]]; then
            pi install "${binary}"
        fi
    done < <(git config -f "${PACKAGE_CONFIG}" --get-regexp 'pi\..*')
fi

## Install uv tools
if git config -f "${PACKAGE_CONFIG}" --get-regexp 'uv\..*' >/dev/null; then
    while IFS=$'\r' read -r package; do
        IFS=' ' read -ra fields <<< "$package"
        pkg="${fields[0]#uv.}"
        binary="${fields[1]:-${pkg}}"
        # N.B. entries named `local` carry a project path as their value; its
        # lockfile is reinstalled every sync so dependency bumps propagate.
        if [[ "${pkg}" == "local" ]]; then
            path="${binary/#\~/$HOME}"
            if [[ ! -d "${path}" ]]; then
                echo "ERROR: no ${path} on local device"
                continue
            fi
            uv tool install --force "${path}"
            continue
        fi

        if ! which "${binary}" >/dev/null 2>&1; then
            # TODO: support injecting in spec
            if [[ "${binary}" == "nvr" ]]; then
                # N.B. required by beancount-language-server
                # TODO: can we update our LSP config to use beancount from the
                # PATH instead?
                uv tool install --with beancount "${pkg}"
            else
                uv tool install "${pkg}"
            fi
        fi
    done < <(git config -f "${PACKAGE_CONFIG}" --get-regexp 'uv\..*')
fi

# Complete post-installation bootstrapping operations
if [[ "${BOOTSTRAP}" == "y" ]]; then
    echo "Setting default shell to zsh..."
    if [[ -f /etc/os-release ]] && grep -q fedora /etc/os-release; then
        # TODO: why do I install this?
        sudo dnf install util-linux-user
    fi
    chsh -s "$(which zsh)"
    sudo chsh -s "$(which zsh)"

    echo "Uploading new ssh key to Github..."
    gh auth login
    gh auth refresh -h github.com -s admin:public_key

    # Now that our ssh key is connected to Github...
    git remote set-url origin git@github.com:TheKevJames/dotsystem.git

    echo "Importing gpg keys..."
    mkdir -p "${GNUPGHOME}"
    chmod 700 "${GNUPGHOME}"
    # TODO: give direct path to `GOPATH="${XDG_DATA_HOME}/go"` ?
    pathadd "${XDG_DATA_HOME}/go/bin"
    # N.B. sometimes this needs to be run twice to import private keys, see
    # `gpg -k` vs `gpg -K`
    passphrase2pgp -se -u "Kevin James <KevinJames@thekev.in>" | gpg --import

    # TODO: should I just add all keys?
    #     curl https://github.com/thekevjames.keys >> ~/.ssh/authorized_keys
    echo "Adding emergency backup key to ~/.ssh/authorized_keys..."
    passphrase2pgp -u emergency -f ssh -p >> ~/.ssh/authorized_keys
    # To regain access to a machine if all goes wrong:
    #     (umask 077; passphrase2pgp -u emergency -f ssh > ~/.ssh/emergency)
    #     ssh-copy-id -i ~/.ssh/id_ed25519 -o 'IdentityFile ~/.ssh/emergency' important.example.com
    #     rm ~/.ssh/emergency
fi

echo "done."

# TODO: flatten if statements in config files (eg. `if [ "$(uname ..."` should be done in ./sync, not at terminal load time
